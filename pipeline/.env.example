# Copiar como .env y reemplazar únicamente los valores necesarios.
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Opcional: sin definir rige DEFAULT_OPENAI_MODEL (util/llm_provider.py); cambiarlo cambia el instrumento.
# OPENAI_MODEL=gpt-6-luna
LLM_REQUEST_TIMEOUT_SECONDS=180
LLM_TRANSPORT_MAX_RETRIES=2

# Configuración alternativa para DeepSeek.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
