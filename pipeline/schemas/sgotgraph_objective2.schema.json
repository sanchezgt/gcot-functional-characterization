{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/sgotgraph-objective2-1.1.schema.json",
  "title": "SGoTGraph objective 2 canonical record",
  "type": "object",
  "required": ["schema_version", "pipeline_version", "trace_id", "source_record", "trace_text", "segments", "nodes", "edges", "validation", "audit"],
  "properties": {
    "schema_version": {"const": "sgotgraph-objective2-1.1"},
    "pipeline_version": {"const": "objective2-1.1"},
    "trace_id": {"type": "string", "minLength": 1},
    "source_record": {"type": "object"},
    "trace_text": {"type": "string", "minLength": 1},
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/segment"}
    },
    "nodes": {
      "type": "array",
      "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "#/$defs/edge"}
    },
    "validation": {"type": "object"},
    "audit": {"type": "object"}
  },
  "additionalProperties": false,
  "$defs": {
    "provenance": {
      "type": "object",
      "required": ["origin", "stage"],
      "properties": {
        "origin": {"enum": ["deterministic", "llm_proposed", "rule_filtered", "human_adjudicated"]},
        "stage": {"type": "string", "minLength": 1},
        "provider": {"type": "string"},
        "model": {"type": "string"},
        "prompt_hash": {"type": "string"},
        "response_id": {"type": "string"},
        "system_fingerprint": {"type": "string"},
        "reasoning_effort": {"type": "string"}
      },
      "additionalProperties": false
    },
    "segment": {
      "type": "object",
      "required": ["segment_id", "text", "start_char", "end_char", "provenance"],
      "properties": {
        "segment_id": {"type": "string"},
        "text": {"type": "string", "minLength": 1},
        "start_char": {"type": "integer", "minimum": 0},
        "end_char": {"type": "integer", "minimum": 1},
        "provenance": {"$ref": "#/$defs/provenance"}
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["segment_id", "text", "start_char", "end_char", "position", "node_type", "provenance"],
      "properties": {
        "segment_id": {"type": "string"},
        "text": {"type": "string"},
        "start_char": {"type": "integer"},
        "end_char": {"type": "integer"},
        "position": {"type": "integer", "minimum": 1},
        "node_type": {"enum": ["PROP", "METHOD", "EVID", "ALT", "CHECK", "REVISE", "OUT"]},
        "review_status": {"type": "string"},
        "ambiguity_codes": {"type": "array", "items": {"type": "string"}},
        "provenance": {"$ref": "#/$defs/provenance"}
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": ["edge_id", "source", "target", "edge_type", "provenance"],
      "properties": {
        "edge_id": {"type": "string"},
        "source": {"type": "string"},
        "target": {"type": "string"},
        "edge_type": {"enum": ["NEXT", "SUPPORTS", "ALTERNATIVE_TO", "CHECKS", "REVISES", "LEADS_TO"]},
        "provenance": {"$ref": "#/$defs/provenance"}
      },
      "additionalProperties": false
    }
  }
}
